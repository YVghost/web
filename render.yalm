services:
  - type: web
    name: MarketU
    env: python
    region: oregon
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn marketcampus.wsgi:application --bind 0.0.0.0:10000 --workers 3 --timeout 120

    envVars:
      - key: PYTHON_VERSION
        value: 3.12
      - key: SECRET_KEY
        generateValue: true
      - key: DEBUG
        value: "False"
      - key: DATABASE_URL
        fromDatabase:
          name: marketu-db
          property: connectionString

databases:
  - name: marketu-db
    region: oregon
    plan: free
